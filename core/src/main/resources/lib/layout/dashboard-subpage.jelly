<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:l="/lib/layout" xmlns:d="jelly:define" xmlns:st="jelly:stapler">
  <st:documentation>
    The page shell of an experimental dashboard tab: the app bar with the dashboard's tabs and actions,
    then the tab's content. Internal, not to be used outside of core.
    Use it from the index page of a jenkins.model.Tab of jenkins.model.dashboard.Dashboard.
  </st:documentation>

  <j:set var="dashboard" value="${it.object}" />
  <l:layout title="${dashboard.displayName}">
    <l:header>
      <script src="${resURL}/jsbundles/pages/dashboard/home.js" type="text/javascript" defer="true" />
    </l:header>
    <l:main-panel>
      <div class="app-build-bar">
        <div class="app-build-bar__content">
          <div class="app-build-bar__content__headline">
            <h1>${dashboard.displayName}</h1>
          </div>
        </div>

        <div class="app-build-bar__tabs">
          <div class="app-build-tabs" data-testid="dashboard-tabs">
            <j:forEach var="tab" items="${dashboard.dashboardTabs}">
              <!-- Tabs are created per request, so compare by type and URL rather than identity -->
              <j:set var="isCurrentTab" value="${tab.class == it.class and tab.urlName == it.urlName}" />
              <a href="${rootURL}/${tab.urlName == null ? '' : tab.urlName + '/'}"
                 class="jenkins-button ${isCurrentTab ? '' : 'jenkins-button--tertiary'}"
                 aria-current="${isCurrentTab ? 'page' : null}">
                <l:icon src="${tab.iconFileName}" />
                ${tab.displayName}
                <l:badge badge="${tab.badge}" />
              </a>
            </j:forEach>
          </div>
        </div>

        <div class="app-build-bar__controls">
          <l:actions it="${dashboard}" url="${rootURL}/" />
        </div>
      </div>

      <div class="app-build-content" style="padding-top: var(--section-padding)">
        <j:if test="${app.systemMessage != null}">
          <div id="systemmessage" class="app-dashboard-system-message">
            <j:out value="${app.markupFormatter.translate(app.systemMessage)}" />
          </div>
        </j:if>
        <d:invokeBody />
      </div>
    </l:main-panel>
  </l:layout>
</j:jelly>
