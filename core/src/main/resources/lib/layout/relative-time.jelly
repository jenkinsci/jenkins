<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler">
  <st:documentation>
    Renders the time span between now and the given time, e.g. "3 min 4 sec",
    and keeps it up to date in the browser.

    <st:attribute name="value" use="required">
      The point in time to measure from, either a java.util.Date, java.util.Calendar,
      java.time.Instant (or other TemporalAccessor with an instant), or epoch milliseconds.
      Times in the future are supported.
    </st:attribute>
    <st:attribute name="template">
      Localized text to place the time span in, with {0} marking where it goes,
      e.g. "Started {0} ago". Defaults to just the time span.
    </st:attribute>
    <st:attribute name="class">
      Additional CSS classes for the element.
    </st:attribute>
  </st:documentation>

  <j:set var="elapsed" value="${h.getElapsedSince(attrs.value)}" />
  <j:set var="template" value="${attrs.template}" />
  <j:if test="${empty(template)}">
    <j:set var="template" value="{0}" />
  </j:if>

  <span class="${attrs.class}"
        data-relative-time-elapsed="${elapsed}"
        data-relative-time-template="${template}"
        data-relative-time-patterns="${h.timeSpanPatterns}">${template.replace('{0}', h.formatTimeSpan(elapsed))}</span>
</j:jelly>
