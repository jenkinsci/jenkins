<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout">
  <st:documentation>
    Renders the button that shows or hides the side panel on small screens.

    <st:attribute name="clazz">
      Additional classes for the button
    </st:attribute>
  </st:documentation>

  <button type="button"
          class="jenkins-button jenkins-button--tertiary app-side-panel-toggle ${attrs.clazz}"
          aria-controls="side-panel"
          aria-expanded="false"
          aria-label="${%toggleSidebar}"
          tooltip="${%toggleSidebar}">
    <l:icon src="symbol-sidebar" />
  </button>
</j:jelly>
