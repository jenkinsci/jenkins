<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:l="/lib/layout" xmlns:st="jelly:stapler">
  <st:documentation>
    A button for navigating between runs, which reveals a list of nearby runs on hover.
    <st:attribute name="href" use="required">
      Link to the adjacent run
    </st:attribute>
    <st:attribute name="menu" use="required">
      URL that serves the list of nearby runs via 'contextMenu'
    </st:attribute>
    <st:attribute name="label" use="required">
      Accessible label for the button
    </st:attribute>
    <st:attribute name="icon" use="required">
      Icon for the button
    </st:attribute>
    <st:attribute name="disabled" type="boolean">
      Whether there is no adjacent run to navigate to
    </st:attribute>
  </st:documentation>

  <a href="${attrs.href}"
     class="jenkins-button jenkins-button--tertiary jenkins-jumplist-link"
     aria-label="${attrs.label}"
     disabled="${attrs.disabled ? true : null}"
     data-href="${attrs.menu}"
     data-tippy-trigger="mouseenter"
     data-tippy-delay="[400, null]"
     data-tippy-offset="[0, 5]"
     data-tippy-touch="false">
    <l:icon src="${attrs.icon}" />
  </a>
</j:jelly>
