<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout">
  <st:documentation>
    Renders one item as a row of an experimental item list. Internal, not to be used outside of core.

    <st:attribute name="job" use="required" type="hudson.model.Item">
      The item to show.
    </st:attribute>
    <st:attribute name="expandable" type="boolean">
      If true, the row is a folder that expands to list the items inside it when clicked, rather than linking to it.
      The folder's page is linked from a button next to its actions.
    </st:attribute>
    <st:attribute name="relativeTo" type="hudson.model.ItemGroup">
      If set, shows the item's name from this item group down, such as "team » job" for an item inside an item
      group inside it. Otherwise, shows the item's display name.
    </st:attribute>
  </st:documentation>

  <j:set var="job" value="${attrs.job}"/>
  <div class="app-temporary-list__item" data-id="${job.fullName}">
    <div class="app-build-item">
      <div class="app-build-item__icon">
        <j:choose>
          <j:when test="${job.iconColor.iconName != null}">
            <l:icon src="symbol-status-${job.iconColor.iconName}" alt="${job.iconColor.description}" />
          </j:when>
          <j:when test="${job.iconColor != null}">
            <!-- This is for special conditions, such as folders -->
            <l:icon src="${job.iconColor.iconClassName}" />
          </j:when>
        </j:choose>
      </div>

      <div class="app-temporary-list__item__details" href="${rootURL}/${job.url}">
        <div class="app-temporary-list__item__details__text">
          <j:set var="name" value="${attrs.relativeTo != null ? h.getRelativeDisplayNameFrom(job, attrs.relativeTo) : job.displayName}" />
          <j:choose>
            <j:when test="${attrs.expandable}">
              <button type="button" class="app-temporary-list__item__label app-dashboard-items__toggle"
                      aria-expanded="false">
                <l:icon src="symbol-chevron-forward" class="app-dashboard-items__chevron" />
                <span class="app-dashboard-items__name" title="${name}">${name}</span>
              </button>
            </j:when>
            <j:otherwise>
              <a class="app-temporary-list__item__label" href="${rootURL}/${job.url}">
                <span class="app-dashboard-items__name" title="${name}">${name}</span>
              </a>
            </j:otherwise>
          </j:choose>

          <j:set var="lastBuild" value="${job.lastBuild}" />
          <j:if test="${lastBuild != null}">
            <div class="app-temporary-list__item__description">
              ${%Description(lastBuild.timestampString, lastBuild.durationString)}
            </div>
          </j:if>
        </div>
      </div>

      <div class="app-temporary-list__item__actions">
        <j:if test="${attrs.expandable}">
          <a class="jenkins-button jenkins-button--tertiary" href="${rootURL}/${job.url}" tooltip="${%Open(name)}"
             aria-label="${%Open(name)}">
            <l:icon src="symbol-arrow-right" />
          </a>
        </j:if>
        <l:actions it="${job}" url="${rootURL}/${job.url}" compact="true" />
      </div>
    </div>
  </div>

</j:jelly>
