  <f:section title="${%Maven Configuration}">
    <f:dropdownDescriptorSelector title="${%Default settings provider}" field="settingsProvider" />
    <f:dropdownDescriptorSelector title="${%Default global settings provider}" field="globalSettingsProvider" />
  </f:section>
</j:jelly>
