<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:l="/lib/layout" xmlns:t="/lib/hudson">
  <!-- One page of items. The wrapper carries where the next page starts, if there is one. Items from inside
       folders, such as search results, are shown with their full names. -->
  <l:ajax>
    <div class="app-dashboard-items__page" data-next-start="${page.nextStart()}" data-count="${page.items().size()}">
      <j:forEach var="item" items="${page.items()}">
        <t:jobListItem job="${item}" showFullName="${page.search() or item.parent != app}" />
      </j:forEach>
    </div>
  </l:ajax>
</j:jelly>
