<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:l="/lib/layout" xmlns:st="jelly:stapler">
  <l:dashboard-subpage>
    <j:set var="page" value="${it.getPage(0, null, null)}" />
    <j:choose>
      <j:when test="${empty(page.items())}">
        <j:choose>
          <j:when test="${it.emptyMessage != null}">
            <l:notice title="${it.emptyMessage}" icon="${it.iconFileName}" />
          </j:when>
          <j:when test="${it.emptyStateView == null}">
            <l:notice title="${%Nothing to show yet}" icon="${it.iconFileName}" />
          </j:when>
          <j:otherwise>
            <st:include it="${it.emptyStateView}" page="noJob.jelly" />
          </j:otherwise>
        </j:choose>
      </j:when>
      <j:otherwise>
        <div class="app-dashboard-items"
             data-items-url="${rootURL}/${it.dashboard.url}${it.urlName ?: 'defaultTab'}/items"
             data-load-failed="${%LoadFailed}"
             data-try-again="${%Try again}"
             data-results="${%Results}"
             data-more-results="${%MoreResults}"
             data-no-results="${%No results found}">
          <l:search-bar id="dashboard-items-search" placeholder="${%Search}" ariaLabel="${%Search} ${it.displayName}"
                        hasKeyboardShortcut="false" />

          <l:notice id="dashboard-items-no-results" icon="symbol-search" title="${%No results found}" clazz="jenkins-hidden" />

          <!-- Tells screen reader users how many results a search found -->
          <p class="jenkins-visually-hidden app-dashboard-items__status" role="status" aria-live="polite" />

          <div class="app-temporary-list app-dashboard-items__list">
            <st:include page="rows.jelly" />
          </div>

          <div class="app-dashboard-items__sentinel" aria-hidden="true" />
        </div>
      </j:otherwise>
    </j:choose>
  </l:dashboard-subpage>
</j:jelly>
