<?jelly escape-by-default='true'?>
<!-- What the body of f:dropdownListBlock in lib/form/dropdownDescriptorSelector.jelly renders, when not selected -->
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout" xmlns:f="/lib/form">
  <j:set var="descriptor" value="${it.descriptor}" />
  <j:set var="instance" value="${null}" />
  <j:set var="readOnlyMode" value="${false}" />
  <j:set var="it" value="${it.object}" />
  <l:ajax>
    <j:set var="help" value="${descriptor.helpFile}"/>
    <j:if test="${help != null}">
      <div class="help-sibling jenkins-select-help">
        <f:helpLink url="${help}" featureName="${descriptor.displayName}"/>
        <f:helpArea/>
      </div>
    </j:if>
    <st:include from="${descriptor}" page="${descriptor.configPage}" optional="true" />
  </l:ajax>
</j:jelly>
