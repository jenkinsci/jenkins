{
  "name": "jenkins-ui",
  "version": "1.0.0",
  "description": "Jenkins User Interface",
  "license": "MIT",
  "author": {
    "name": "Tom Fennelly",
    "email": "tom.fennelly@gmail.com",
    "url": "https://github.com/tfennelly"
  },
  "private": true,
  "scripts": {
    "dev": "webpack --config webpack.config.js",
    "prod": "webpack --config webpack.config.js --mode=production",
    "build": "yarn prod",
    "start": "yarn dev --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:js": "eslint . && prettier --check .",
    "lint:js-ci": "eslint . -f checkstyle -o target/eslint-warnings.xml",
    "lint:css": "stylelint src/main/scss",
    "lint:css-ci": "stylelint src/main/scss --custom-formatter stylelint-checkstyle-reporter -o target/stylelint-warnings.xml",
    "lint:ci": "yarn lint:js-ci && yarn lint:css-ci",
    "lint:fix": "eslint --fix . && prettier --write . && stylelint src/main/scss --fix",
    "lint": "yarn lint:js && yarn lint:css"
  },
  "devDependencies": {
    "@babel/cli": "8.1.0",
    "@babel/core": "8.1.3",
    "@babel/preset-env": "8.0.7",
    "@eslint/js": "10.0.1",
    "babel-loader": "10.1.1",
    "clean-webpack-plugin": "4.0.0",
    "css-loader": "7.1.5",
    "css-minimizer-webpack-plugin": "8.0.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-formatter-checkstyle": "9.0.1",
    "globals": "17.14.0",
    "handlebars-loader": "1.7.3",
    "jsdom": "31.0.1",
    "mini-css-extract-plugin": "2.10.2",
    "postcss": "8.5.33",
    "postcss-loader": "8.2.2",
    "postcss-preset-env": "11.6.3",
    "postcss-scss": "4.0.9",
    "prettier": "3.10.1",
    "sass": "1.108.2",
    "sass-loader": "17.1.1",
    "style-loader": "4.0.0",
    "stylelint": "18.1.0",
    "stylelint-checkstyle-reporter": "2.0.0",
    "stylelint-config-standard-scss": "18.0.0",
    "vite": "^8.2.2",
    "vitest": "5.1.1",
    "webpack": "5.113.0",
    "webpack-cli": "7.3.1",
    "webpack-remove-empty-scripts": "1.1.1"
  },
  "dependencies": {
    "handlebars": "4.7.10",
    "hotkeys-js": "3.13.15",
    "jquery": "4.1.0",
    "lodash": "4.18.1",
    "sortablejs": "1.15.7",
    "tippy.js": "6.3.7"
  },
  "browserslist": [
    "defaults",
    "not IE 11"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "yarn@4.19.0"
}
