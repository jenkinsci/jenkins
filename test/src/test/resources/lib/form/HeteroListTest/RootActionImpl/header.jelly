<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:l="/lib/layout" xmlns:f="/lib/form">
  <l:layout title="Testing hetero-list header rendering">
    <l:main-panel>
      <f:hetero-list name="no-care" descriptors="${it.descriptorList}" hasHeader="${it.hasHeader}" disableDragAndDrop="${it.disableDragAndDrop}"/>
    </l:main-panel>
  </l:layout>
</j:jelly>
